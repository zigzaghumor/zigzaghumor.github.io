---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
    xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
{% for pair in site.data.translations %}
{% assign key = pair[0] %}
{% assign entry = pair[1] %}
{% if key == 'home' %}
  {% assign priority = '1.0' %}
  {% assign changefreq = 'weekly' %}
{% elsif key == 'experience' %}
  {% assign priority = '0.8' %}
  {% assign changefreq = 'monthly' %}
{% else %}
  {% assign priority = '0.7' %}
  {% assign changefreq = 'monthly' %}
{% endif %}
<url>
  <loc>{{ site.canonical }}{{ entry.en }}</loc>
  <xhtml:link rel="alternate" hreflang="en" href="{{ site.canonical }}{{ entry.en }}" />
  <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.canonical }}{{ entry['zh-CN'] }}" />
  <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.canonical }}{{ entry.en }}" />
  <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  <changefreq>{{ changefreq }}</changefreq>
  <priority>{{ priority }}</priority>
</url>

<url>
  <loc>{{ site.canonical }}{{ entry['zh-CN'] }}</loc>
  <xhtml:link rel="alternate" hreflang="en" href="{{ site.canonical }}{{ entry.en }}" />
  <xhtml:link rel="alternate" hreflang="zh-CN" href="{{ site.canonical }}{{ entry['zh-CN'] }}" />
  <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.canonical }}{{ entry.en }}" />
  <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  <changefreq>{{ changefreq }}</changefreq>
  <priority>{{ priority }}</priority>
</url>
{% endfor %}
</urlset>
